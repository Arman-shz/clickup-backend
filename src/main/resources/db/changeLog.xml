<?xml version="1.0" encoding="UTF-8"?>
<!--
    Master changelog. Liquibase owns the schema outright: Hibernate is configured with
    `database.generation=none`, so nothing here is generated from the entities.

    Liquibase has no reactive driver, so it runs over the JDBC datasource at startup
    while the application itself talks to Postgres reactively. That is the only reason
    quarkus-jdbc-postgresql is on the classpath.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <include file="db/changelog/001-initial-schema.sql"/>

    <!-- Guarded by the `seed` context, which only dev and test activate. -->
    <include file="db/changelog/002-seed-data.sql"/>

</databaseChangeLog>
